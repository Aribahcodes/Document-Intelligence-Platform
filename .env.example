# Copy this file to .env and fill in real values for local development.
# Never commit the real .env file.

APP_ENV=development
SECRET_KEY=change-me-to-a-random-value

# SQLite by default. For Postgres/MySQL, set e.g.:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Google Gemini API key - https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional: path to the tesseract binary if not on PATH (mainly for local Windows/Mac dev)
TESSERACT_CMD=

# Upload / validation limits
MAX_UPLOAD_SIZE_BYTES=15728640
MAX_PAGE_COUNT=3
OCR_TEXT_MIN_CHARS=30
VALIDATION_TOLERANCE=0.01

LOG_LEVEL=INFO